# ローカル開発用環境変数（.env.local にコピーして使う）
JWT_SECRET=local-dev-secret-change-this

# AWS 設定（~/.aws/credentials があれば不要）
AWS_REGION=ap-northeast-1
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key

# DynamoDB テーブル名（sam deploy 前はそのまま使う）
USERS_TABLE=OfficialSupportSystem-dev-Users
ORGANIZATIONS_TABLE=OfficialSupportSystem-dev-Organizations
RACE_TABLE=OfficialSupportSystem-dev-Race
ENTRY_TABLE=OfficialSupportSystem-dev-Entry
START_DRIVER_TABLE=OfficialSupportSystem-dev-StartDriver
PIT_ASSIGNMENT_TABLE=OfficialSupportSystem-dev-PitAssignment
PIT_LOG_TABLE=OfficialSupportSystem-dev-PitLog
PIT_LOG_HISTORY_TABLE=OfficialSupportSystem-dev-PitLogHistory
RETIRE_TABLE=OfficialSupportSystem-dev-Retire
OUTPOST_LOG_TABLE=OfficialSupportSystem-dev-OutpostLog
